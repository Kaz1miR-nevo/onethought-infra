# =============================================================================
# OneThought Web - Production Environment Variables
# =============================================================================
# Copy this file to prod.web.env and fill in the values
# NEVER commit .env files to git!
# =============================================================================

# Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=prod

# Supabase Configuration (Production)
NEXT_PUBLIC_SUPABASE_URL=https://hutrzgxhgnkkkvwmlytm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_prod_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_prod_service_key_here

# Site URLs
NEXT_PUBLIC_SITE_URL=https://domain.com
NEXT_PUBLIC_API_URL=https://domain.com/api

# Database (optional, for migrations)
DATABASE_URL=your_prod_database_url_here





