# =============================================================================
# OneThought API - Production Environment Variables
# =============================================================================
# Copy this file to prod.api.env and fill in the values
# NEVER commit .env files to git!
# =============================================================================

# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase Configuration (Production)
SUPABASE_URL=https://hutrzgxhgnkkkvwmlytm.supabase.co
SUPABASE_ANON_KEY=your_prod_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_prod_service_key_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_min_32_chars_here

# CORS
CORS_ORIGIN=https://domain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# API Version
API_VERSION=v1

# Redis Configuration (optional)
# Format: redis://host:port/db where db is 0-15
REDIS_URL=redis://redis:6379/1
REDIS_PREFIX=prod:

