# =============================================================================
# Production Secrets Example
# =============================================================================
# ⚠️ NEVER COMMIT THIS FILE WITH REAL VALUES!
# 
# Copy this file to secrets.prod.yaml and fill in the values:
#   cp secrets.prod.yaml.example secrets.prod.yaml
#
# Then use with helm:
#   helm upgrade --install onethought ./helm/onethought \
#     -f helm/onethought/values.prod.yaml \
#     -f secrets.prod.yaml
# =============================================================================

secrets:
  useExternalSecrets: false
  
  # Supabase Service Role Key (server-side only, NEVER expose to client)
  supabaseServiceRoleKey: "YOUR_PROD_SUPABASE_SERVICE_ROLE_KEY"
  
  # JWT Secret for token signing  
  jwtSecret: "your-production-jwt-secret-at-least-32-characters"
  
  # Database URL (if needed for direct DB access)
  databaseUrl: "postgres://postgres:PASSWORD@db.hutrzgxhgnkkkvwmlytm.supabase.co:6543/postgres"












