# =============================================================================
# OneThought Web - Stage Environment Variables
# =============================================================================
# Copy this file to stage.web.env and fill in the values
# NEVER commit .env files to git!
# =============================================================================

# Environment
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=stage

# Supabase Configuration (Stage)
NEXT_PUBLIC_SUPABASE_URL=https://cgiqlvscetphwvvffdlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_stage_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_stage_service_key_here

# Site URLs
NEXT_PUBLIC_SITE_URL=https://stage.domain.com
NEXT_PUBLIC_API_URL=https://stage.domain.com/api

# Database (optional, for migrations)
DATABASE_URL=your_stage_database_url_here


