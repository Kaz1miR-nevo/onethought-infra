# =============================================================================
# Stage Secrets Example
# =============================================================================
# ⚠️ NEVER COMMIT THIS FILE WITH REAL VALUES!
# 
# Copy this file to secrets.stage.yaml and fill in the values:
#   cp secrets.stage.yaml.example secrets.stage.yaml
#
# Then use with helm:
#   helm upgrade --install onethought ./helm/onethought \
#     -f helm/onethought/values.stage.yaml \
#     -f secrets.stage.yaml
# =============================================================================

secrets:
  useExternalSecrets: false
  
  # Supabase Service Role Key (server-side only, NEVER expose to client)
  supabaseServiceRoleKey: "YOUR_STAGE_SUPABASE_SERVICE_ROLE_KEY"
  
  # JWT Secret for token signing
  jwtSecret: "your-jwt-secret-at-least-32-characters"
  
  # Database URL (if needed for direct DB access)
  databaseUrl: "postgres://postgres:PASSWORD@db.cgiqlvscetphwvvffdlj.supabase.co:6543/postgres"







