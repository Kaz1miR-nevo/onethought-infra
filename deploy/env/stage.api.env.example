# =============================================================================
# OneThought API - Stage Environment Variables
# =============================================================================
# Copy this file to stage.api.env and fill in the values
# NEVER commit .env files to git!
# =============================================================================

# Server Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Supabase Configuration (Stage)
SUPABASE_URL=https://cgiqlvscetphwvvffdlj.supabase.co
SUPABASE_ANON_KEY=your_stage_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_stage_service_key_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_min_32_chars_here

# CORS
CORS_ORIGIN=https://stage.domain.com,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# API Version
API_VERSION=v1

# Redis Configuration (optional)
# Format: redis://host:port/db where db is 0-15
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=stage:

